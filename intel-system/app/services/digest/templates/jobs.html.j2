<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<!--[if mso]>
<xml>
  <o:OfficeDocumentSettings>
    <o:PixelsPerInch>96</o:PixelsPerInch>
  </o:OfficeDocumentSettings>
</xml>
<![endif]-->
<title>{{ subject }}</title>
<style type="text/css">
  /* === Resets === */
  body, #bodyTable { margin:0; padding:0; width:100%; min-width:100%; }
  img { border:0; display:block; max-width:100%; height:auto; }
  table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }
  /* Do NOT set color:inherit on `a` globally — it overrides button text color in Apple Mail */
  a { text-decoration:none; }

  /* === Apply button — all pseudo-states locked to white text === */
  a.apply-btn,
  a.apply-btn:link,
  a.apply-btn:visited,
  a.apply-btn:hover,
  a.apply-btn:active,
  a.apply-btn:focus {
    color:#ffffff !important;
    text-decoration:none !important;
  }
  a.apply-btn:hover { background-color:#312e81 !important; border-color:#312e81 !important; }

  /* === Mobile responsive === */
  @media only screen and (max-width:620px) {
    body, #bodyTable { background-color: #ffffff !important; }
    .main-container { border: 1px solid #f97316 !important; border-radius: 24px !important; box-shadow: none !important; }
    .full-width  { width:100% !important; min-width:100% !important; }
    .no-radius   { border-radius:0 !important; }
    .header-td   { padding:24px 20px 28px !important; }
    .section-td  { padding:20px 16px !important; }
    .card-td     { padding:14px 16px !important; }
    .footer-td   { padding:16px 20px !important; }
    h1.title     { font-size:22px !important; }
    .stat-wrap   { display:none !important; }
  }
</style>
</head>

<body style="margin:0;padding:0;background-color:#fff0e6;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

<!-- Outer table -->
<table id="bodyTable" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
  style="background-color:#fff0e6;width:100%;">
<tr><td align="center" style="padding:40px 16px;">

  <!-- ╔══════════════════════════════════════╗
       ║         EMAIL CONTAINER             ║
       ╚══════════════════════════════════════╝ -->
  <table class="wrap main-container" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
    style="margin: 0 auto; max-width:600px;width:600px;background-color:#ffffff;border-radius:24px;border:1px solid #f97316;box-shadow: 0 8px 24px rgba(249, 115, 22, 0.15);border-collapse:separate;overflow:hidden;">

    <!-- ══════════════════════════════════════
         HEADER
    ══════════════════════════════════════ -->
    <tr>
      <td class="header-td" bgcolor="#ffffff"
        style="background-color:#ffffff;padding:40px 36px 32px;border-radius:24px 24px 0 0;">

        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
          <tr>
            <!-- Left: branding + title -->
            <td valign="top" style="padding-right:16px;">
              <p style="margin:0 0 10px;font-family:Georgia, 'Times New Roman', serif;
                font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#000000;">
                DAILY INTEL
              </p>
              <h1 class="title" style="margin:0 0 10px;
                font-family:Georgia,'Times New Roman',serif;
                font-size:32px;font-weight:700;color:#0f172a;letter-spacing:-0.5px;line-height:1.2;">
                Business Jobs Digest
              </h1>
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;color:#64748b;line-height:1.4;">
                {{ generated_at }}
              </p>
            </td>
            <!-- Right: stat badge -->
            <td class="stat-wrap" valign="top" align="right" style="white-space:nowrap;">
              <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-left:auto;">
                <tr>
                  <td style="background-color:#1a1a1a;border:1px solid #000000;
                    border-radius:8px;padding:16px 20px;text-align:center;">
                    <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:30px;font-weight:800;color:#ffffff;line-height:1;">{{ count }}</p>
                    <p style="margin:4px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#a3a3a3;">
                      TODAY
                    </p>
                  </td>
                </tr>
                {% if count > 0 %}
                <tr>
                  <td style="padding-top:8px;text-align:center;">
                    <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;color:#475569;font-weight:500;">
                      {{ count }}&nbsp;role{{ 's' if count != 1 else '' }}
                    </p>
                  </td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>
        </table>

      </td>
    </tr>

    <!-- ══════════════════════════════════════
         JOB LIST
    ══════════════════════════════════════ -->
    {% if jobs %}
    <tr>
      <td class="section-td" style="padding:28px 32px 24px;border-top:none;">

        <!-- Section header row -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
          style="margin-bottom:18px;">
          <tr>
            <td valign="middle">
              <p style="margin:0;font-family:Georgia, 'Times New Roman', serif;
                font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.6px;color:#94a3b8;">
                Latest Opportunities
              </p>
            </td>
            <td valign="middle" align="right">
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                font-size:11px;font-weight:600;color:#6366f1;">
                {{ count }}&nbsp;role{{ 's' if count != 1 else '' }}
              </p>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding-top:10px;border-bottom:none;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
        </table>

        {% for job in jobs %}
        <!-- Job card -->
        <div class="card-td" style="margin-bottom:{{ '0' if loop.last else '14px' }}; padding:18px 20px; background-color:transparent; border-radius:10px;">
              <!-- Company + score row -->
              <div style="margin-bottom:5px;">
                <p style="margin:0;display:inline-block;
                  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                  font-size:10px;font-weight:700;text-transform:uppercase;
                  letter-spacing:0.8px;color:#6366f1;">
                  {{ job.company | default('Unknown Company', true) }}
                </p>
                {% set score_pct = (job.rank_score * 100) | int %}
                {% if score_pct > 0 %}
                <p style="margin:0;display:inline-block;float:right;
                  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                  font-size:10px;font-weight:600;
                  color:{{ '#059669' if score_pct >= 80 else ('#d97706' if score_pct >= 60 else '#94a3b8') }};">
                  &#9679;&nbsp;{{ score_pct }}%&nbsp;match
                </p>
                {% endif %}
              </div>

              <!-- Job title -->
              <p style="margin:0 0 8px;
                font-family:Georgia,'Times New Roman',serif;
                font-size:20px;font-weight:700;color:#0f172a;line-height:1.35;letter-spacing:-0.2px;">
                {{ job.job_title }}
              </p>

              <!-- Description snippet -->
              {% if job.ai_summary %}
              <p style="margin:0 0 14px;
                font-family:'Open Sans', 'Segoe UI', 'Apple SD Gothic Neo', 'Lucida Grande', 'Lucida Sans Unicode', sans-serif;
                font-size:13px;color:#4b5563;line-height:1.6;font-style:italic;">
                {{ job.ai_summary }}
              </p>
              {% elif job.description %}
              <p style="margin:0 0 14px;
                font-family:'Open Sans', 'Segoe UI', 'Apple SD Gothic Neo', 'Lucida Grande', 'Lucida Sans Unicode', sans-serif;
                font-size:13px;color:#4b5563;line-height:1.6;">
                {{ job.description[:200] }}{% if job.description | length > 200 %}&hellip;{% endif %}
              </p>
              {% endif %}

              <!-- Tags + Apply button row -->
              <div style="margin-top:4px;">
                <div style="margin-bottom:12px;">
                    {% if job.location %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#fff7ed;color:#c2410c;
                      margin-bottom:4px;margin-right:4px;white-space:nowrap;">
                      {{ job.location }}
                    </span>
                    {% endif %}
                    {% if job.remote %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#f0fdf4;color:#15803d;
                      margin-bottom:4px;margin-right:4px;white-space:nowrap;">
                      Remote
                    </span>
                    {% endif %}
                    {% if job.experience_level and job.experience_level != 'unknown' %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#fff7ed;color:#c2410c;
                      margin-bottom:4px;margin-right:4px;white-space:nowrap;">
                      {{ job.experience_level | title }}
                    </span>
                    {% endif %}
                    {% if job.matched_keywords %}
                    {% for tag in job.matched_keywords.split(',') %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#faf5ff;color:#7e22ce;
                      margin-bottom:4px;margin-right:4px;white-space:nowrap;">
                      {{ tag | trim }}
                    </span>
                    {% endfor %}
                    {% endif %}
                </div>

                {% if job.job_url %}
                <div style="display:inline-block; background-color:#3730a3; border-radius:4px; border:2px solid #312e81;">
                  <a href="{{ job.job_url }}" target="_blank" rel="noopener noreferrer"
                    style="display:inline-block;padding:7px 18px;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                      font-size:12px;font-weight:700;
                      text-decoration:none;
                      letter-spacing:0.5px;line-height:1.2;white-space:nowrap;">
                    <span style="color:#ffffff !important;">Apply&nbsp;&#8594;</span>
                  </a>
                </div>
                {% endif %}
              </div>
        </div>
        {% endfor %}

      </td>
    </tr>

    {% else %}
    <!-- ══════════════════════════════════════
         EMPTY STATE
    ══════════════════════════════════════ -->
    <tr>
      <td style="padding:56px 36px;text-align:center;border-top:none;">
        <p style="margin:0 0 12px;font-size:36px;line-height:1;">&#128679;</p>
        <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:14px;color:#94a3b8;">
          No new EV business roles today. Check back tomorrow.
        </p>
      </td>
    </tr>
    {% endif %}

    <!-- ══════════════════════════════════════
         FOOTER
    ══════════════════════════════════════ -->
    <tr>
      <td class="footer-td no-radius" bgcolor="#4b4b4b"
        style="background-color:#4b4b4b;border-top:none;padding:20px 36px;
          text-align:center;border-radius:0 0 24px 24px;">
        <p style="margin:0 0 4px;font-family:Georgia, 'Times New Roman', serif;
          font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#000000;">
          DAILY INTEL
        </p>
        <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:11px;color:#d1d5db;line-height:1.5;">
          Generated {{ generated_at }}&nbsp;&middot;&nbsp;One digest, every morning.
        </p>
      </td>
    </tr>

  </table>
</td></tr>
</table>

</body>
</html>
