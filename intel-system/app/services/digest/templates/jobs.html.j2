<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<!--[if mso]>
<xml>
  <o:OfficeDocumentSettings>
    <o:PixelsPerInch>96</o:PixelsPerInch>
  </o:OfficeDocumentSettings>
</xml>
<![endif]-->
<title>EV Business Jobs Digest</title>
<style type="text/css">
  /* Reset only — no class-based styling, Gmail strips this block */
  body, #bodyTable { margin:0; padding:0; width:100%; }
  img { border:0; display:block; }
  table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }

  /* Apply button: lock ALL pseudo-states.
     CRITICAL: Gmail overrides <a> color with `a{color:#1155CC!important}`.
     The <span> inside is immune — Gmail's selector only targets <a>, not descendants. */
  a.apply-btn,
  a.apply-btn:link,
  a.apply-btn:visited,
  a.apply-btn:hover,
  a.apply-btn:active { text-decoration:none !important; }
  a.apply-btn:hover td { background-color:#312e81 !important; }

  @media only screen and (max-width:620px) {
    .wrap        { width:100% !important; }
    .header-td   { padding:24px 20px 28px !important; }
    .section-td  { padding:0 12px 16px !important; }
    .card-td     { padding:14px 16px !important; }
    .stat-badge  { display:none !important; }
    h1.title     { font-size:22px !important; }
  }
</style>
</head>

<body style="margin:0;padding:0;background-color:#f97316;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

<table id="bodyTable" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
  style="background-color:#f97316;width:100%;">
<tr><td align="center" style="padding:32px 16px;">

  <!-- ══ CONTAINER ══ -->
  <table class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
    style="max-width:600px;width:600px;background-color:#fffaf5;border-radius:12px;">

    <!-- ══ HEADER ══ -->
    <tr>
      <td class="header-td" bgcolor="#fffaf5"
        style="background-color:#fffaf5;padding:36px 36px 32px;border-radius:12px 12px 0 0;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
          <tr>
            <td valign="top" style="padding-right:16px;">
              <p style="margin:0 0 10px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#059669;">
                EV / E-MOBILITY ECOSYSTEM{% if total_batches is defined and total_batches > 1 %} &nbsp;&middot;&nbsp; BATCH {{ batch_num }}/{{ total_batches }}{% endif %}
              </p>
              <h1 class="title" style="margin:0 0 10px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-0.5px;line-height:1.25;">
                Business Jobs Digest
              </h1>
              <p style="margin:0;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;color:#64748b;line-height:1.4;">
                {{ generated_at }}
              </p>
            </td>
            <!-- Count badge -->
            <td class="stat-badge" valign="top" align="right" style="white-space:nowrap;">
              <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-left:auto;">
                <tr>
                  <td style="background-color:rgba(52,211,153,0.12);border:1px solid rgba(52,211,153,0.3);
                    border-radius:10px;padding:12px 20px;text-align:center;">
                    <p style="margin:0;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:30px;font-weight:800;color:#34d399;line-height:1;">{{ count }}</p>
                    <p style="margin:3px 0 0;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#059669;">
                      ROLE{{ 'S' if count != 1 else '' }}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- ══ FILTER NOTE ══ -->
    <tr>
      <td style="padding:0;border-left:3px solid #22c55e;background-color:#f0fdf4;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
          <tr>
            <td style="padding:12px 20px;
              font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
              font-size:12px;color:#166534;line-height:1.5;">
              <strong style="color:#15803d;">Filtered for:</strong>
              EV &amp; E-Mobility domain
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- ══ JOB LIST ══ -->
    {% if jobs %}
    <tr>
      <td class="section-td" style="padding:20px 24px 24px;">

        {% for job in jobs %}
        <!-- Job card -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
          style="margin-bottom:{{ '0' if loop.last else '14px' }};
            border:none;border-radius:10px;">
          <tr>
            <td class="card-td"
              style="padding:18px 20px;background-color:transparent;border-radius:10px;">

              <!-- Company + score row -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
                style="margin-bottom:5px;">
                <tr>
                  <td valign="middle">
                    <p style="margin:0;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:10px;font-weight:700;text-transform:uppercase;
                      letter-spacing:0.8px;color:#6366f1;">
                      {{ job.company }}
                    </p>
                  </td>
                  <td valign="middle" align="right">
                    {% set score_pct = (job.rank_score * 100) | int %}
                    {% if score_pct > 0 %}
                    <p style="margin:0;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:10px;font-weight:600;
                      color:{{ '#059669' if score_pct >= 80 else ('#d97706' if score_pct >= 60 else '#94a3b8') }};">
                      &#9679;&nbsp;{{ score_pct }}%&nbsp;match
                    </p>
                    {% endif %}
                  </td>
                </tr>
              </table>

              <!-- Job title -->
              <p style="margin:0 0 8px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:16px;font-weight:700;color:#0f172a;line-height:1.35;letter-spacing:-0.2px;">
                {{ job.job_title }}
                {% if job.matched_keywords %}
                <span style="display:inline-block; font-size:11px; font-weight:600; color:#15803d; background-color:#dcfce7; padding:2px 6px; border-radius:4px; margin-left:6px; vertical-align:middle; border:1px solid #bbf7d0; letter-spacing:0.5px;">[ {{ job.matched_keywords | title }} ]</span>
                {% endif %}
              </p>

              <!-- Description snippet -->
              {% if job.ai_summary %}
              <p style="margin:0 0 14px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;color:#4b5563;line-height:1.6;font-style:italic;">
                {{ job.ai_summary }}
              </p>
              {% elif job.description %}
              <p style="margin:0 0 14px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;color:#4b5563;line-height:1.6;">
                {{ job.description[:200] }}{% if job.description | length > 200 %}&hellip;{% endif %}
              </p>
              {% endif %}

              <!-- Tags + Apply button row -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <!-- Tags cell -->
                  <td valign="middle" style="padding-right:12px;">
                    {% if job.location %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#f1f5f9;color:#475569;
                      margin-right:4px;white-space:nowrap;">
                      &#128205;&nbsp;{{ job.location }}
                    </span>
                    {% endif %}
                    {% if job.remote %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#f0fdf4;color:#15803d;
                      margin-right:4px;white-space:nowrap;">
                      Remote
                    </span>
                    {% endif %}
                    {% if job.experience_level and job.experience_level != 'unknown' %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#fff7ed;color:#c2410c;
                      margin-right:4px;white-space:nowrap;">
                      {{ job.experience_level | title }}
                    </span>
                    {% endif %}
                    {% for skill in (job.extracted_skills or [])[:3] %}
                    <span style="display:inline-block;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;font-weight:500;
                      padding:3px 9px;border-radius:99px;
                      background-color:#faf5ff;color:#7e22ce;
                      margin-right:4px;white-space:nowrap;">
                      {{ skill }}
                    </span>
                    {% endfor %}
                  </td>

                  <!-- Apply button cell
                       GMAIL FIX: background on <td>, text color on <span>.
                       Gmail's `a{color:#1155CC!important}` targets <a> only,
                       not child <span> elements. -->
                  {% if job.job_url %}
                  <td valign="middle" align="right" style="white-space:nowrap;">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                      href="{{ job.job_url }}"
                      style="height:34px;v-text-anchor:middle;width:100px;"
                      arcsize="20%" stroke="f" fillcolor="#3730a3">
                      <w:anchorlock/>
                      <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:12px;font-weight:700;">
                        Apply &#8594;
                      </center>
                    </v:roundrect>
                    <![endif]-->
                    <!--[if !mso]><!-->
                    <a href="{{ job.job_url }}" class="apply-btn"
                      target="_blank" rel="noopener noreferrer">
                      <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                        <tr>
                          <td align="center"
                            style="background-color:#3730a3;border-radius:4px;border:2px solid #312e81;
                              padding:7px 18px;white-space:nowrap;">
                            <span style="color:#ffffff !important;
                              font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                              font-size:12px;font-weight:700;
                              letter-spacing:0.5px;line-height:1.2;">
                              Apply&nbsp;&#8594;
                            </span>
                          </td>
                        </tr>
                      </table>
                    </a>
                    <!--<![endif]-->
                  </td>
                  {% endif %}
                </tr>
              </table>

            </td>
          </tr>
        </table>
        {% endfor %}

      </td>
    </tr>

    {% else %}
    <!-- ══ EMPTY STATE ══ -->
    <tr>
      <td style="padding:56px 36px;text-align:center;border-top:none;">
        <p style="margin:0 0 8px;font-size:36px;line-height:1;">&#128679;</p>
        <p style="margin:0;
          font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:14px;color:#94a3b8;">
          No new EV business roles in the last 24 hours. Check back tomorrow.
        </p>
      </td>
    </tr>
    {% endif %}

    <!-- ══ FOOTER ══ -->
    <tr>
      <td bgcolor="#4b4b4b"
        style="background-color:#4b4b4b;border-top:none;padding:20px 36px;
          text-align:center;border-radius:0 0 12px 12px;">
        <p style="margin:0 0 4px;
          font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#f3f4f6;">
          DAILY INTEL
        </p>
        <p style="margin:0;
          font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:11px;color:#d1d5db;line-height:1.5;">
          EV Business Jobs &nbsp;&middot;&nbsp; {{ generated_at }}
          &nbsp;&middot;&nbsp; Only BD, Sales &amp; Marketing roles in EV/e-mobility
        </p>
      </td>
    </tr>

  </table>
</td></tr>
</table>

</body>
</html>
