<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<!--[if mso]>
<xml>
  <o:OfficeDocumentSettings>
    <o:PixelsPerInch>96</o:PixelsPerInch>
  </o:OfficeDocumentSettings>
</xml>
<![endif]-->
<title>{{ subject }}</title>
<style type="text/css">
  /* === Resets === */
  body, #bodyTable { margin:0; padding:0; width:100%; min-width:100%; }
  img { border:0; display:block; max-width:100%; height:auto; }
  table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }
  /* Do NOT set color:inherit on `a` globally — it overrides button text color in Apple Mail */
  a { text-decoration:none; }

  /* === Apply button — all pseudo-states locked to white text === */
  a.apply-btn,
  a.apply-btn:link,
  a.apply-btn:visited,
  a.apply-btn:hover,
  a.apply-btn:active,
  a.apply-btn:focus {
    color:#ffffff !important;
    text-decoration:none !important;
  }
  a.apply-btn:hover { background-color:#312e81 !important; border-color:#312e81 !important; }

  /* === Mobile responsive === */
  @media only screen and (max-width:620px) {
    body, #bodyTable { background-color: #ffffff !important; }
    .main-container { border: 2px solid #f97316 !important; border-radius: 0 !important; }
    .full-width  { width:100% !important; min-width:100% !important; }
    .no-radius   { border-radius:0 !important; }
    .header-td   { padding:24px 20px 28px !important; }
    .section-td  { padding:20px 16px !important; }
    .card-td     { padding:14px 16px !important; }
    .footer-td   { padding:16px 20px !important; }
    h1.title     { font-size:22px !important; }
    .stat-wrap   { display:none !important; }
  }
</style>
</head>

<body style="margin:0;padding:0;background-color:#f97316;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

<!-- Outer table -->
<table id="bodyTable" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
  style="background-color:#f97316;width:100%;">
<tr><td align="center" style="padding:32px 16px;">

  <!-- ╔══════════════════════════════════════╗
       ║         EMAIL CONTAINER             ║
       ╚══════════════════════════════════════╝ -->
  <table class="full-width main-container" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
    style="margin: 0 auto; max-width:600px;width:600px;background-color:#fffaf5;border-radius:12px;">

    <!-- ══════════════════════════════════════
         HEADER
    ══════════════════════════════════════ -->
    <tr>
      <td class="header-td no-radius" bgcolor="#fffaf5"
        style="background-color:#fffaf5;padding:36px 36px 32px;border-radius:12px 12px 0 0;">

        {% set total_jobs = (sections.get('jobs_target', []) | length) + (sections.get('jobs_open', []) | length) %}
        {% set ns = namespace(total=0) %}
        {% for k, v in sections.items() %}{% set ns.total = ns.total + (v | length) %}{% endfor %}

        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
          <tr>
            <!-- Left: branding + title -->
            <td valign="top" style="padding-right:16px;">
              <p style="margin:0 0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#818cf8;">
                DAILY INTEL
              </p>
              <h1 class="title" style="margin:0 0 10px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-0.5px;line-height:1.25;">
                Morning Digest
              </h1>
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;color:#64748b;line-height:1.4;">
                {{ generated_at }}
              </p>
            </td>
            <!-- Right: stat badge -->
            <td class="stat-wrap" valign="top" align="right" style="white-space:nowrap;">
              <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-left:auto;">
                <tr>
                  <td style="background-color:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.28);
                    border-radius:10px;padding:12px 20px;text-align:center;">
                    <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:30px;font-weight:800;color:#a5b4fc;line-height:1;">{{ ns.total }}</p>
                    <p style="margin:3px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#6366f1;">
                      TODAY
                    </p>
                  </td>
                </tr>
                {% if total_jobs > 0 %}
                <tr>
                  <td style="padding-top:8px;text-align:center;">
                    <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                      font-size:11px;color:#475569;font-weight:500;">
                      {{ total_jobs }}&nbsp;job{{ 's' if total_jobs != 1 else '' }}
                    </p>
                  </td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>
        </table>

      </td>
    </tr>

    <!-- ══════════════════════════════════════
         SECTIONS
    ══════════════════════════════════════ -->
    {% set section_labels = {
      'jobs_target': 'Target Companies Hiring',
      'jobs_open':   'Open Opportunities',
      'news':        'Industry News',
      'telegram':    'Telegram Highlights',
      'whatsapp':    'WhatsApp Highlights',
      'linkedin':    'LinkedIn Updates'
    } %}
    {% set display_order = ['jobs_target', 'jobs_open', 'news', 'telegram', 'whatsapp', 'linkedin'] %}

    {% for sec_key in display_order %}
    {% if sec_key in sections %}
    {% set sec_items = sections[sec_key] %}
    {% set is_jobs = sec_key.startswith('jobs') %}

    <tr>
      <td class="section-td"
        style="padding:28px 32px {{ '20px' if is_jobs else '24px' }};border-top:none;">

        <!-- Section header row -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
          style="margin-bottom:18px;">
          <tr>
            <td valign="middle">
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.6px;color:#94a3b8;">
                {{ section_labels.get(sec_key, sec_key) }}
              </p>
            </td>
            <td valign="middle" align="right">
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                font-size:11px;font-weight:600;color:#6366f1;">
                {{ sec_items | length }}&nbsp;{{ 'role' if is_jobs else 'item' }}{{ 's' if sec_items | length != 1 else '' }}
              </p>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding-top:10px;border-bottom:none;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
        </table>

        {% if is_jobs %}
        {# ── Job Cards ── #}
        {% for item in sec_items %}
          {# Parse summary: "Company | Job Title" #}
          {% if item.summary %}
            {% set parts = item.summary.split(' | ') %}
            {% if parts | length > 1 %}
              {% set company   = parts[0] | trim %}
              {% set job_title = parts[1] | trim %}
            {% else %}
              {% set company   = '' %}
              {% set job_title = item.summary | trim %}
            {% endif %}
          {% else %}
            {% set company   = '' %}
            {% set job_title = 'Job Posting' %}
          {% endif %}
          {% set item_url  = url_map.get(item.raw_item_id) if item.raw_item_id else none %}
          {% set score_pct = (item.rank_score * 100) | int %}

        <div class="card-td" style="margin-bottom:{{ '0' if loop.last else '12px' }}; padding:18px 20px; background-color:transparent; border-radius:10px;">
          
          <!-- company -->
          {% if company %}
          <div style="margin-bottom:6px;">
            <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
              font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#6366f1;">
              {{ company }}
            </p>
          </div>
          {% endif %}

          <!-- job title -->
          <p style="margin:0 0 14px;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
            font-size:16px;font-weight:700;color:#0f172a;line-height:1.35;letter-spacing:-0.2px;">
            {{ job_title }}
          </p>

          <!-- CTA button -->
          {% if item_url %}
          <!--[if mso]>
          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
            href="{{ item_url }}"
            style="height:38px;v-text-anchor:middle;width:148px;"
            arcsize="16%" stroke="f" fillcolor="#3730a3">
            <w:anchorlock/>
            <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;">
              APPLY NOW &#8594;
            </center>
          </v:roundrect>
          <![endif]-->
          <!--[if !mso]><!-->
          <div style="display:inline-block; background-color:#3730a3; border-radius:4px; border:2px solid #312e81;">
            <a href="{{ item_url }}" target="_blank" rel="noopener noreferrer"
              style="display:inline-block;padding:10px 24px;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                font-size:13px;font-weight:700;
                text-decoration:none;
                letter-spacing:0.6px;line-height:1.2;white-space:nowrap;">
              <span style="color:#ffffff !important;">APPLY&nbsp;NOW&nbsp;&#8594;</span>
            </a>
          </div>
          <!--<![endif]-->
          {% else %}
          <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            font-size:11px;color:#cbd5e1;font-style:italic;">
            Link unavailable
          </p>
          {% endif %}
        </div>
        {% endfor %}

        {% else %}
        {# ── Content Items (news, telegram, whatsapp, linkedin) ── #}
        {% for item in sec_items %}
          {% set _raw_sum = item.summary or '' %}
          {% if ' | ' in _raw_sum %}
            {% set parts = _raw_sum.split(' | ', 1) %}
            {% set headline  = parts[0] | trim %}
            {% set body_text = parts[1] | trim %}
          {% else %}
            {% set headline  = _raw_sum | trim %}
            {% set body_text = '' %}
          {% endif %}
          {% set score_pct = (item.rank_score * 100) | int %}
          
          {% if ' [Tags: ' in body_text %}
            {% set body_parts = body_text.split(' [Tags: ') %}
            {% set body_text = body_parts[0] %}
            {% set tags_str = body_parts[1].replace(']', '') %}
          {% else %}
            {% set tags_str = '' %}
          {% endif %}

        <div style="margin-bottom:{{ '0' if loop.last else '16px' }}; padding-bottom:{{ '0' if loop.last else '16px' }};">
          <p style="margin:0 0 4px;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
            font-size:14px;font-weight:600;color:#0f172a;line-height:1.45;">
            {{ headline }}{% if body_text %}&hellip;{% endif %}
          </p>

          {% if body_text %}
          <p style="margin:0 0 6px;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
            font-size:13px;color:#4b5563;line-height:1.6;">
            {{ body_text }}
          </p>
          {% endif %}
          
          {% if tags_str %}
          <div style="margin-top:6px;">
            {% for tag in tags_str.split(',') %}
            <span style="display:inline-block; padding:2px 6px; margin:0 4px 4px 0; background-color:#e0e7ff; color:#4338ca; border-radius:4px; font-size:10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">{{ tag | trim }}</span>
            {% endfor %}
          </div>
          {% endif %}

        </div>
        {% endfor %}
        {% endif %}

      </td>
    </tr>

    {% endif %}
    {% endfor %}

    <!-- ══════════════════════════════════════
         EMPTY STATE
    ══════════════════════════════════════ -->
    {% if not sections %}
    <tr>
      <td style="padding:56px 36px;text-align:center;border-top:none;">
        <p style="margin:0 0 12px;font-size:36px;line-height:1;">&#128679;</p>
        <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:14px;color:#94a3b8;">
          Nothing to show today. Check back tomorrow.
        </p>
      </td>
    </tr>
    {% endif %}

    <!-- ══════════════════════════════════════
         FOOTER
    ══════════════════════════════════════ -->
    <tr>
      <td class="footer-td no-radius" bgcolor="#4b4b4b"
        style="background-color:#4b4b4b;border-top:none;padding:20px 36px;
          text-align:center;border-radius:0 0 12px 12px;">
        <p style="margin:0 0 4px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#f3f4f6;">
          DAILY INTEL
        </p>
        <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          font-size:11px;color:#d1d5db;line-height:1.5;">
          Generated {{ generated_at }}&nbsp;&middot;&nbsp;One digest, every morning.
        </p>
      </td>
    </tr>

  </table>
</td></tr>
</table>

</body>
</html>
